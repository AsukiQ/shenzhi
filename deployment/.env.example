# Copy to deployment/.env; keep actual secrets out of Git.
HTTP_PORT=18088
NEO4J_PASSWORD=replace-with-development-password
JWT_SECRET=replace-with-long-random-development-secret

# Existing user MySQL. This may remain on the original server.
USER_MYSQL_HOST=your-existing-user-mysql-host
USER_MYSQL_PORT=3306
USER_MYSQL_DATABASE=paperddl
USER_MYSQL_USER=your-user-db-user
USER_MYSQL_PASSWORD=replace-with-user-db-password
USER_MYSQL_CONNECTION_LIMIT=10

# Paper metadata and FTS5 index are supplied as migration-data/runtime-data.
# The Node and Python services read the same file.
PAPER_SQLITE_PATH=/data/papers_fts.db

# Deprecated rollback-only paper MySQL settings. They are not used by the
# current Node service but may be kept while validating the SQLite cutover.
# PAPER_MYSQL_HOST=127.0.0.1
# PAPER_MYSQL_DATABASE=paperddl_papers
# PAPER_MYSQL_USER=paperddl_papers
# PAPER_MYSQL_PASSWORD=replace-with-paper-db-password

# Optional: these legacy MYSQL_* variables are still accepted by source mode.
# Do not use them to point both logical databases at the same server.
