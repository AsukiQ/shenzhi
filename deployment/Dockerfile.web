FROM node:22-bookworm-slim AS build
WORKDIR /app/paperddl
COPY paperddl/package*.json ./
COPY paperddl/server/package*.json ./server/
COPY paperddl/web/package*.json ./web/
RUN npm ci
COPY paperddl/web ./web
RUN npm --prefix web run build
FROM nginx:1.28-alpine
COPY --from=build /app/paperddl/web/dist /usr/share/nginx/html
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf
