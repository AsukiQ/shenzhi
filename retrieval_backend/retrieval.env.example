# bm25 | hybrid | full
RETRIEVAL_MODE=hybrid
RETRIEVAL_HOST=127.0.0.1
RETRIEVAL_PORT=8080
MAX_BODY_BYTES=1048576
MAX_WORKERS=16
REQUEST_TIMEOUT=30
# AUTH_TOKEN_ENV=RETRIEVAL_AUTH_TOKEN
# RETRIEVAL_AUTH_TOKEN=replace-with-a-secret-from-the-service-manager
# WARMUP_QUERY=knowledge graph retrieval
QUERY_GLOSSARY=/path/to/retrieval_backend/data/domain_glossary.v1.json
# QUERY_TRANSLATOR_URL=http://127.0.0.1:8090/translate
TRANSLATOR_TIMEOUT=0.8
RECALL_K=1000
RERANK_K=50
RERANKER_BATCH_SIZE=4
FUZZY_WEIGHT=0.35
GRAPH_WEIGHT=0.8
GRAPH_SEED_K=12
GRAPH_EXPAND_K=100
GRAPH_VALUE_LIMIT=16
GRAPH_INTENT_ENABLED=1

# Optional authenticated Neo4j filter. Leave NEO4J_HTTP_URI unset to disable it.
NEO4J_HTTP_URI=http://127.0.0.1:17474
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-secret
NEO4J_DATABASE=neo4j
