# Minimal default runtime; optional model paths only needed for hybrid/full.
RETRIEVAL_MODE=bm25
RETRIEVAL_HOST=127.0.0.1
RETRIEVAL_PORT=8080
RECALL_K=300
MAX_WORKERS=8
ZILLIZ_DENSE_ENABLED=0
# NEO4J_HTTP_URI=http://127.0.0.1:17474
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=replace-with-development-password
# STAGE0_ROOT=/path/to/stage0
# STAGE0_CHECKPOINT=/path/to/checkpoint
# STAGE0_SKILLS=/path/to/selected_skills.jsonl
# STAGE0_BASE_MODEL=/path/to/model
# RERANKER_MODEL=/path/to/reranker
