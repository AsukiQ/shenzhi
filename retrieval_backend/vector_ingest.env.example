# Copy to an untracked file and source it; never commit real credentials.
PAPER_SEARCH_DB=/root/jiansuo/retrieval_backend/papers_fts.db
QWEN_EMBEDDING_URL=https://your-qwen-compatible-endpoint/v1/embeddings
QWEN_EMBEDDING_API_KEY=replace-me
QWEN_EMBEDDING_MODEL=qwen3-embedding-8b
# Optional. Omit for provider default (currently observed as 768); set 1024
# to request a 1024-dimensional vector and use a separate collection.
# QWEN_EMBEDDING_DIMENSIONS=1024
# The client accepts OpenAI-compatible `data` responses and DashScope-style
# `output.embeddings` responses. Use the provider's documented endpoint.
# Optional if the provider requires a document instruction.
# QWEN_EMBEDDING_INSTRUCTION=
QWEN_EMBEDDING_TIMEOUT=60
EMBEDDING_BATCH_SIZE=8

ZILLIZ_URI=https://your-cluster.api.gcp-us-west1.zillizcloud.com
ZILLIZ_TOKEN=replace-me
ZILLIZ_COLLECTION=papers_qwen3_embedding_8b
VECTOR_INGEST_STATE=/root/jiansuo/retrieval_backend/data/vector_ingest_state.json
VECTOR_INGEST_FAILED=/root/jiansuo/retrieval_backend/data/vector_ingest_failed.jsonl
