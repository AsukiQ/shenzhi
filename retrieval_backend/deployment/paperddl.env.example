SHENZHI_ROOT=/path/to/shenzhi
PYTHON_BIN=/usr/bin/python3
PAPER_SEARCH_DB=/path/to/shenzhi/retrieval_backend/papers_fts.db
RETRIEVAL_MODE=bm25
RETRIEVAL_HOST=127.0.0.1
RETRIEVAL_PORT=8080
RECALL_K=1000
RERANK_K=50
FUZZY_WEIGHT=0.35
GRAPH_WEIGHT=0.8
GRAPH_SEED_K=12
GRAPH_EXPAND_K=50
GRAPH_VALUE_LIMIT=12
GRAPH_INTENT_ENABLED=1
MAX_BODY_BYTES=1048576
MAX_WORKERS=8
REQUEST_TIMEOUT=30
QUERY_GLOSSARY=/path/to/shenzhi/retrieval_backend/data/domain_glossary.v1.json

# Optional Qwen + Zilliz dense retrieval. Keep real values in an untracked
# environment file or a systemd credential/secret store.
ZILLIZ_DENSE_ENABLED=0
ZILLIZ_COLLECTION=paper_embedding_chunks_v1_1024
QWEN_EMBEDDING_URL=https://your-qwen-endpoint/v1
QWEN_EMBEDDING_API_KEY=replace-me
QWEN_EMBEDDING_MODEL=qwen3-embedding-8b
QWEN_EMBEDDING_DIMENSIONS=1024
ZILLIZ_URI=https://your-zilliz-endpoint
ZILLIZ_TOKEN=replace-me
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
